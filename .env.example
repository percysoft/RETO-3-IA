# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
# Bun carga .env automáticamente; la clave solo se lee en el backend.

# --- Proveedor LLM (Anthropic) ---
# Clave de la API. Obligatoria para el chat; sin ella el servidor arranca y avisa "IA sin configurar".
# (También se acepta ANTHROPIC_API_KEY como alternativa.)
LLM_API_KEY=
# Modelo. Si se deja vacío se usa claude-opus-5-5.
LLM_MODEL=claude-opus-5-5
# Informativo (se muestra en /api/health cuando la IA no está configurada). Hoy el único adaptador es Anthropic.
LLM_PROVIDER=anthropic

# --- Servidor ---
PORT=3000
# Dirección de escucha. 127.0.0.1 = solo local. Use 0.0.0.0 para exponerlo (despliegue).
HOST=127.0.0.1
# Orígenes externos permitidos por CORS, separados por coma. Vacío = solo mismo origen.
CORS_ORIGINS=
# Máximo de mensajes de chat por IP y por minuto.
RATE_LIMIT_CHAT_PER_MIN=30

# --- Límites de costo (CA1 y requisito de costo) ---
# Tope de iteraciones herramienta -> modelo por turno.
MAX_ITERACIONES=25
# Tope de tokens (entrada + salida, incluida caché) por sesión.
MAX_TOKENS_SESION=100000
# Timeout por llamada al proveedor, en milisegundos.
LLM_TIMEOUT_MS=60000

# --- Acceso, proxy y despliegue (Render) ---
# Entorno. Con NODE_ENV=production, ACCESS_KEY es OBLIGATORIA y el servidor no arranca sin ella.
NODE_ENV=
# Clave de acceso compartida (mínimo 16 caracteres, sin espacios al inicio ni al final; genere una con `openssl rand -base64 24`). Protege
# /api/chat, /api/sessions/:id y /api/diagnostico (se envía en la cabecera X-Access-Key). Vacía = acceso
# abierto (solo recomendable en local). /api/health y los archivos estáticos son siempre públicos.
ACCESS_KEY=
# Demo pública SIN clave de acceso: con NODE_ENV=production permite arrancar sin ACCESS_KEY. Cualquiera con el enlace
# podrá usar la clave de IA (acotado por RATE_LIMIT_CHAT_PER_MIN y GLOBAL_TOKEN_BUDGET). No se combina con ACCESS_KEY.
ALLOW_OPEN_ACCESS=false
# Confiar en una cabecera de proxy para la IP del cliente (límite por IP). Por defecto false: NO se confía
# en ninguna cabecera. Actívelo solo tras validar con GET /api/diagnostico qué cabecera lleva la IP real.
TRUST_PROXY=false
# Cabecera con la cadena de IPs (solo si TRUST_PROXY=true) y número de proxies de confianza contados
# desde la DERECHA de la cadena. Las entradas de la izquierda las controla el cliente y se ignoran.
TRUST_PROXY_HEADER=x-forwarded-for
TRUST_PROXY_HOPS=1
# Tope GLOBAL de tokens del proceso (suma de todas las sesiones; se reinicia con el proceso). Sin definir = sin tope.
# Entero positivo (una línea vacía se rechaza al arrancar). Ejemplo para una demostración:
# GLOBAL_TOKEN_BUDGET=500000
# true = avisa en /api/health y en la UI que el almacenamiento es efímero (p. ej. Render Free).
EPHEMERAL_STORAGE=false
